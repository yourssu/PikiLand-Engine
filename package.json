{
  "name": "pikiland-engine",
  "version": "1.0.0",
  "description": "PikiLand CLI Execution Engine in TypeScript + Bun",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --minify ./src/index.ts --outfile pikiland-cli"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.9",
    "@ai-sdk/openai": "^1.1.13",
    "@octokit/rest": "^21.1.1",
    "ai": "^4.1.44",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fflate": "^0.8.3",
    "simple-git": "^3.27.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
